#!/usr/bin/make -f

# Build the CMake tests only when the caller did not ask for nocheck.
ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
QTRANSLATE_BUILD_TESTS = OFF
else
QTRANSLATE_BUILD_TESTS = ON
endif

%:
	dh $@ --builddirectory=build/debian

override_dh_auto_configure:
	dh_auto_configure -- -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/usr -DQTRANSLATE_BUILD_TESTS=$(QTRANSLATE_BUILD_TESTS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	xvfb-run -a dh_auto_test
endif

override_dh_auto_install:
	dh_auto_install --destdir=debian/qtranslate

# debhelper 13.11.4 does not skip README.Debian under nodoc, so exclude it
# explicitly; debian/copyright and the changelog are still installed.
override_dh_installdocs:
ifeq (,$(filter nodoc,$(DEB_BUILD_OPTIONS)))
	dh_installdocs
else
	dh_installdocs --exclude=README.Debian
endif

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build/debian

override_dh_missing:
	dh_missing --fail-missing

override_dh_icons:
